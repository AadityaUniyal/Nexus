# ==============================================================================
# NEXUS Unified Environment Configuration (.env)
# ==============================================================================

# Application Runtime
PROJECT_NAME="NEXUS Operational Intelligence Platform"
VERSION="2.1.0"
API_V1_STR="/api/v1"
APP_ENV="development"
SECRET_KEY="replace_with_a_secure_random_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL Neon Serverless or Local)
DATABASE_URL="postgresql+asyncpg://nexus:nexuspassword@localhost:5432/nexus"
POSTGRES_USER="nexus"
POSTGRES_PASSWORD="nexuspassword"
POSTGRES_DB="nexus"

# Redis Cache & SSE
REDIS_URL="redis://localhost:6379/0"

# AI Inference (Groq free tier / Gemini)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""

# Geospatial & Weather
LOCATION_PROVIDER="geoapify"
GEOAPIFY_API_KEY=""
GEOAPIFY_BASE_URL="https://api.geoapify.com"

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
BACKEND_INTERNAL_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_DATA_PROVIDER="api"
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_MAPLIBRE_STYLE="https://demotiles.maplibre.org/style.json"
NEXT_PUBLIC_GEOAPIFY_API_KEY=""

# CORS & Routing
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"
FRONTEND_URL="http://localhost:3000"

# Cloud Adapters (Azure IoT Hub, Microsoft Fabric)
AZURE_IOT_HUB_ENABLED=true
FABRIC_ONELAKE_ENABLED=true

# ==============================================================================
# AZURE FREE TIER SERVICES
# ==============================================================================

# Azure Identity (Service Principal or Managed Identity)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Azure Application Insights (FREE: 5 GB/month ingestion)
# Get from: Azure Portal > Application Insights > Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=""
AZURE_MONITOR_ENABLED=true

# Azure Blob Storage (FREE: 5 GB LRS for 12 months)
# Get from: Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_ENABLED=true

# Azure Key Vault (FREE: 10,000 operations/month)
# Get from: Azure Portal > Key Vault > Vault URI
AZURE_KEYVAULT_URL=""

# Azure IoT Hub (FREE F1: 8,000 messages/day)
AZURE_IOT_HUB_CONNECTION_STRING=""
AZURE_IOT_HUB_HOSTNAME=""

# Azure Functions (FREE: 1M executions/month)
AZURE_FUNCTIONS_ENABLED=true

# Microsoft Fabric / OneLake
FABRIC_WORKSPACE_ID=""

# Azure SQL Database (FREE: 100K vCore seconds/month, 32 GB storage)
# Set this ONLY if using Azure SQL instead of Neon PostgreSQL
# AZURE_SQL_CONNECTION_STRING=""
GEMINI_MODEL="gemini-3.5-flash"
