# =============================================================================
# NEXUS Environment Variables Template (Public & Sanitized)
# =============================================================================

# Identity & Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"
CLERK_ISSUER="https://your-instance.clerk.accounts.dev"
CLERK_JWKS_URL="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret_here"

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://nexus_user:nexus_password@localhost:5432/nexus_db?sslmode=prefer"

# Redis In-Memory Coordination & Realtime Cache
REDIS_URL="redis://localhost:6379/0"

# AI Language Explanation (Optional Groq Provider)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Cloud & Enterprise Integrations (Optional Microsoft Fabric & Azure IoT)
FABRIC_ONELAKE_ENABLED=true
AZURE_IOT_HUB_ENABLED=true
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
FABRIC_WORKSPACE_ID=""

# API & Networking
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"
APP_ENV="development"
LOG_LEVEL="INFO"
