# =============================================================================
# NEXUS Security & Repository Ignore Rules
# =============================================================================

# Environment & Secrets (NEVER COMMIT ACTIVE SECRETS)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.secret

# Node / Frontend Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# Python / Backend Artifacts
.venv/
venv/
env/
__pycache__/
backend/__pycache__/
backend/app/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
backend/.pytest_cache/
tests/**/__pycache__/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Database Local SQLite / Cache
*.sqlite
*.sqlite3
*.db
database/*.sqlite
database/*.db

# OS / IDE Artifacts
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
