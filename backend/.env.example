# NEXUS Backend Environment Configuration
PROJECT_NAME="NEXUS Operational Intelligence Platform"
VERSION="2.1.0"
API_V1_STR="/api/v1"
APP_ENV="development"
SECRET_KEY="replace_with_a_secure_random_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Neon Database Connection String (Serverless / Neon / Local)
DATABASE_URL="postgresql+asyncpg://nexus:nexuspassword@localhost:5432/nexus"

# Redis Cache / SSE Hub
REDIS_URL="redis://localhost:6379/0"

# AI Inference Providers (Groq primary, Gemini fallback)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Location & Spatial Intelligence (Geoapify)
LOCATION_PROVIDER="geoapify"
GEOAPIFY_API_KEY=""
GEOAPIFY_BASE_URL="https://api.geoapify.com"

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"
FRONTEND_URL="http://localhost:3000"

# Cloud Integrations (Azure IoT Hub, Microsoft Fabric OneLake)
AZURE_IOT_HUB_ENABLED=true
FABRIC_ONELAKE_ENABLED=true
