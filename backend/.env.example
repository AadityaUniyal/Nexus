# NEXUS Backend Environment Configuration
PROJECT_NAME="NEXUS Operational Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Neon Database Connection String (Serverless)
DATABASE_URL="postgresql://neondb_owner:npg_your_password_here@ep-your-endpoint-name.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Groq AI Inference
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Optional Cloud Integrations (Microsoft Fabric OneLake, Azure IoT)
FABRIC_ONELAKE_ENABLED=true
AZURE_IOT_HUB_ENABLED=true
