# NEXUS Backend Environment Configuration
PROJECT_NAME="NEXUS Operational Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="nexus_super_secret_jwt_signing_key_production_ready_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Neon Database Connection String
DATABASE_URL="postgresql+asyncpg://nexus_user:nexus_password@localhost:5432/nexus_db"

# Groq AI Inference
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Optional Cloud Integrations (Microsoft Fabric OneLake, Azure IoT)
FABRIC_ONELAKE_ENABLED=true
AZURE_IOT_HUB_ENABLED=true
