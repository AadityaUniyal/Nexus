{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "8229663020833809353"
    }
  },
  "parameters": {
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "rg-nexus-real",
      "metadata": {
        "description": "Name of the resource group"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "austriaeast",
      "allowedValues": [
        "austriaeast",
        "southeastasia",
        "eastasia",
        "koreacentral",
        "malaysiawest"
      ],
      "metadata": {
        "description": "Azure region for regional resources (must be an allowed student region)"
      }
    },
    "mapsLocation": {
      "type": "string",
      "defaultValue": "global",
      "metadata": {
        "description": "Location for Azure Maps account"
      }
    },
    "baseName": {
      "type": "string",
      "defaultValue": "nexus",
      "minLength": 3,
      "maxLength": 10,
      "metadata": {
        "description": "Base name prefix for resources"
      }
    },
    "notificationEmail": {
      "type": "string",
      "defaultValue": "240211539@geu.ac.in",
      "metadata": {
        "description": "Notification email for cost budget alerts"
      }
    },
    "budgetAmount": {
      "type": "int",
      "defaultValue": 100,
      "metadata": {
        "description": "Total subscription budget amount for alert baseline ($100 student credit)"
      }
    },
    "budgetStartDate": {
      "type": "string",
      "defaultValue": "2026-10-01T00:00:00Z",
      "metadata": {
        "description": "Start date for budget tracking (YYYY-MM-01 format)"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2021-04-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Project": "NEXUS",
        "Environment": "Development",
        "ManagedBy": "Bicep"
      }
    },
    {
      "condition": "[not(empty(parameters('notificationEmail')))]",
      "type": "Microsoft.Consumption/budgets",
      "apiVersion": "2021-10-01",
      "name": "nexus-student-budget",
      "properties": {
        "timeGrain": "Monthly",
        "amount": "[parameters('budgetAmount')]",
        "category": "Cost",
        "timePeriod": {
          "startDate": "[parameters('budgetStartDate')]"
        },
        "notifications": {
          "Threshold_50_Percent": {
            "enabled": true,
            "operator": "GreaterThan",
            "threshold": 50,
            "contactEmails": [
              "[parameters('notificationEmail')]"
            ]
          },
          "Threshold_80_Percent": {
            "enabled": true,
            "operator": "GreaterThan",
            "threshold": 80,
            "contactEmails": [
              "[parameters('notificationEmail')]"
            ]
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "nexus-resources-deployment",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "baseName": {
            "value": "[parameters('baseName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "mapsLocation": {
            "value": "[parameters('mapsLocation')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "13579196438775843058"
            }
          },
          "parameters": {
            "baseName": {
              "type": "string",
              "defaultValue": "nexus",
              "minLength": 3,
              "maxLength": 10,
              "metadata": {
                "description": "Base name for resources"
              }
            },
            "location": {
              "type": "string",
              "defaultValue": "austriaeast",
              "metadata": {
                "description": "Deployment location for regional resources"
              }
            },
            "mapsLocation": {
              "type": "string",
              "defaultValue": "global",
              "metadata": {
                "description": "Location for Azure Maps (supports global or regional)"
              }
            },
            "uniqueSuffix": {
              "type": "string",
              "defaultValue": "[take(uniqueString(resourceGroup().id), 12)]",
              "metadata": {
                "description": "Unique suffix for globally unique resource names"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))]",
              "location": "[parameters('location')]"
            },
            {
              "type": "Microsoft.Maps/accounts",
              "apiVersion": "2023-06-01",
              "name": "[format('{0}-maps-{1}', parameters('baseName'), parameters('uniqueSuffix'))]",
              "location": "[parameters('mapsLocation')]",
              "sku": {
                "name": "G2"
              },
              "properties": {
                "disableLocalAuth": false
              }
            },
            {
              "type": "Microsoft.KeyVault/vaults",
              "apiVersion": "2023-07-01",
              "name": "[take(format('{0}-kv-{1}', parameters('baseName'), parameters('uniqueSuffix')), 24)]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "family": "A",
                  "name": "standard"
                },
                "tenantId": "[subscription().tenantId]",
                "enableRbacAuthorization": true,
                "enableSoftDelete": true,
                "softDeleteRetentionInDays": 7
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2023-01-01",
              "name": "[toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix')))]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Standard_LRS"
              },
              "kind": "StorageV2",
              "properties": {
                "minimumTlsVersion": "TLS1_2",
                "supportsHttpsTrafficOnly": true,
                "allowBlobPublicAccess": false,
                "accessTier": "Hot"
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices",
              "apiVersion": "2023-01-01",
              "name": "[format('{0}/{1}', toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix'))), 'default')]",
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix'))))]"
              ]
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2023-01-01",
              "name": "[format('{0}/{1}/{2}', toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix'))), 'default', 'telemetry-exports')]",
              "properties": {
                "publicAccess": "None"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix'))), 'default')]"
              ]
            },
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2022-10-01",
              "name": "[format('{0}-logs-{1}', parameters('baseName'), parameters('uniqueSuffix'))]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30
              }
            },
            {
              "type": "Microsoft.Insights/components",
              "apiVersion": "2020-02-02",
              "name": "[format('{0}-ai-{1}', parameters('baseName'), parameters('uniqueSuffix'))]",
              "location": "[parameters('location')]",
              "kind": "web",
              "properties": {
                "Application_Type": "web",
                "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('baseName'), parameters('uniqueSuffix')))]",
                "IngestionMode": "LogAnalytics",
                "publicNetworkAccessForIngestion": "Enabled",
                "publicNetworkAccessForQuery": "Enabled"
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('baseName'), parameters('uniqueSuffix')))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.Maps/accounts', format('{0}-maps-{1}', parameters('baseName'), parameters('uniqueSuffix')))]",
              "name": "[guid(resourceId('Microsoft.Maps/accounts', format('{0}-maps-{1}', parameters('baseName'), parameters('uniqueSuffix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))), '423170ca-a8f6-4b0f-8487-9e4eb8f49bfa')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '423170ca-a8f6-4b0f-8487-9e4eb8f49bfa')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix')))]",
                "[resourceId('Microsoft.Maps/accounts', format('{0}-maps-{1}', parameters('baseName'), parameters('uniqueSuffix')))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.KeyVault/vaults', take(format('{0}-kv-{1}', parameters('baseName'), parameters('uniqueSuffix')), 24))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', take(format('{0}-kv-{1}', parameters('baseName'), parameters('uniqueSuffix')), 24)), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))), '4633458b-17de-408a-b874-0445c86b69e6')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', take(format('{0}-kv-{1}', parameters('baseName'), parameters('uniqueSuffix')), 24))]",
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix')))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix'))))]",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix')))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))), 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix')))]",
                "[resourceId('Microsoft.Storage/storageAccounts', toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix'))))]"
              ]
            }
          ],
          "outputs": {
            "managedIdentityId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix')))]"
            },
            "managedIdentityClientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))), '2023-01-31').clientId]"
            },
            "managedIdentityPrincipalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-id-{1}', parameters('baseName'), parameters('uniqueSuffix'))), '2023-01-31').principalId]"
            },
            "mapsAccountId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Maps/accounts', format('{0}-maps-{1}', parameters('baseName'), parameters('uniqueSuffix')))]"
            },
            "mapsAccountName": {
              "type": "string",
              "value": "[format('{0}-maps-{1}', parameters('baseName'), parameters('uniqueSuffix'))]"
            },
            "keyVaultId": {
              "type": "string",
              "value": "[resourceId('Microsoft.KeyVault/vaults', take(format('{0}-kv-{1}', parameters('baseName'), parameters('uniqueSuffix')), 24))]"
            },
            "keyVaultUri": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', take(format('{0}-kv-{1}', parameters('baseName'), parameters('uniqueSuffix')), 24)), '2023-07-01').vaultUri]"
            },
            "storageAccountId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Storage/storageAccounts', toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix'))))]"
            },
            "storageAccountName": {
              "type": "string",
              "value": "[toLower(format('{0}st{1}', parameters('baseName'), parameters('uniqueSuffix')))]"
            },
            "logAnalyticsId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('baseName'), parameters('uniqueSuffix')))]"
            },
            "appInsightsConnectionString": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-ai-{1}', parameters('baseName'), parameters('uniqueSuffix'))), '2020-02-02').ConnectionString]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'nexus-resources-deployment'), '2025-04-01').outputs.managedIdentityClientId.value]"
    },
    "mapsAccountName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'nexus-resources-deployment'), '2025-04-01').outputs.mapsAccountName.value]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'nexus-resources-deployment'), '2025-04-01').outputs.keyVaultUri.value]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'nexus-resources-deployment'), '2025-04-01').outputs.storageAccountName.value]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'nexus-resources-deployment'), '2025-04-01').outputs.appInsightsConnectionString.value]"
    }
  }
}