{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS Operational Intelligence & Decision Simulation Platform",
  "scripts": {
    "dev": "npm run dev:frontend",
    "build": "npm run build:frontend",
    "test": "npm run test:backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start:frontend": "npm run start --prefix frontend",
    "typecheck:frontend": "cd frontend && npx tsc --noEmit",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "worker:backend": "cd backend && python -m app.workers.worker",
    "test:backend": "python -m pytest backend/tests",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "operational-intelligence",
    "decision-simulation",
    "fastapi",
    "nextjs",
    "pipecat",
    "geoapify",
    "open-meteo"
  ],
  "author": "NEXUS Platform Team",
  "license": "MIT"
}
